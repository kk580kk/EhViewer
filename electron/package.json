{
  "name": "ehviewer-electron",
  "version": "0.1.0",
  "description": "Cross-platform desktop client for EhViewer powered by Electron and React",
  "main": "main.js",
  "author": "Hippo Seven",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "concurrently -k \"cross-env BROWSER=none vite --port 5173\" \"wait-on http://localhost:5173 && electron .\"",
    "build:renderer": "vite build",
    "build": "npm run build:renderer && electron-builder --dir",
    "dist": "npm run build:renderer && electron-builder",
    "lint": "eslint src --ext .jsx,.js,.ts,.tsx"
  },
  "dependencies": {
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.4.0",
    "@vitejs/plugin-react": "^4.1.0",
    "concurrently": "^8.2.0",
    "cross-env": "^7.0.3",
    "electron": "^29.3.0",
    "electron-builder": "^24.11.0",
    "eslint": "^8.57.0",
    "wait-on": "^7.0.1",
    "vite": "^5.2.0"
  }
}